    {
      "id": "PUSH-001",
      "family": "Frozen intent and explicit leases",
      "invariant": "A retry publishes the captured source only when its explicit destination lease and remote settings still hold.",
      "rootCause": "Retries rebuilt from mutable branch/configuration state can overwrite work or change destinations.",
      "sourcePaths": [
        "Classes/git/RepositoryRemoteService.swift",
        "Classes/Controllers/RepositoryPushRecovery*",
        "Classes/Controllers/RepositoryRejectedPushRecovery*"
      ],
      "requiredChecks": [
        "correctness",
        "thread-sanitizer"
      ],
      "tests": [
        {
          "source": "GitXTests/RepositoryServiceTests.swift",
          "identifier": "GitXTests/RepositoryForgeCoordinatorTests/testRetryReplacesFetchedTipWithFrozenSourceEvenIfLocalBranchMoves",
          "role": "valid",
          "oracle": "Read the actual bare remote ref and require the captured source OID."
        },
        {
          "source": "GitXTests/RepositoryServiceTests.swift",
          "identifier": "GitXTests/RepositoryForgeCoordinatorTests/testRetryCannotReplaceNewerRemoteCommit",
          "role": "failure",
          "oracle": "Read the bare remote before and after both fetch timings; the newer OID must survive."
        },
        {
          "source": "GitXTests/RepositoryServiceTests.swift",
          "identifier": "GitXTests/RepositoryForgeCoordinatorTests/testRemoteSettingsDriftRequiresFreshPush",
          "role": "boundary",
          "oracle": "Configuration drift refuses retry without replacing the captured plan."
        }
      ]
    },
