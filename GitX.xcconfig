// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

// Applies only to targets that set no identity of their own. Every native target
// overrides this from the project file, because Xcode ranks target settings above
// any xcconfig. Changing it here does not change how GitX.app is signed.
CODE_SIGN_IDENTITY = -
ARCHS = arm64

// Default repo for UI screenshot tests. Override on CI via:
//   xcodebuild ... GITX_SCREENSHOT_REPO=/tmp/gitx-screenshot-repo
GITX_SCREENSHOT_REPO = $(SRCROOT)

// Public GitHub App device-flow identifiers. Local developers may provide
// these values from Dev.xcconfig; this file never contains a private key.
GITX_GITHUB_APP_CLIENT_ID =
GITX_GITHUB_APP_SLUG =

#include? "Dev.xcconfig"
